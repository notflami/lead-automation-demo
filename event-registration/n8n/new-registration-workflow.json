{
  "name": "Event registration → Telegram alert + confirmation email",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "new-registration",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "a1f0c2d4-0001-4c1e-9a10-000000000001",
      "name": "New registration",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 200],
      "webhookId": "b2e1d3c5-0001-4f2a-8b20-000000000001",
      "credentials": {
        "httpHeaderAuth": { "id": "REPLACE_ME", "name": "Event webhook secret" }
      }
    },
    {
      "parameters": {
        "chatId": "REPLACE_WITH_YOUR_CHAT_ID",
        "text": "={{ $json.body.status === 'waitlisted' ? '⏳ Waiting list' : '✅ New reservation' }}: {{ $json.body.name }}\n{{ $json.body.guest_count }} people · {{ $json.body.registration_id }}\n{{ $json.body.phone }}",
        "additionalFields": {}
      },
      "id": "a1f0c2d4-0002-4c1e-9a10-000000000002",
      "name": "Notify organizers (Telegram)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [280, 100],
      "credentials": {
        "telegramApi": { "id": "REPLACE_ME", "name": "Telegram account" }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.body.email }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1f0c2d4-0003-4c1e-9a10-000000000003",
      "name": "Guest left an email?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [280, 320]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.body.email }}",
        "subject": "={{ $json.body.language === 'de' ? 'Ihre Reservierung' : 'Your reservation' }}: {{ $json.body.event_name }} ({{ $json.body.registration_id }})",
        "emailType": "text",
        "message": "={{ $json.body.language === 'de' ? 'Hallo ' + $json.body.name + ',\\n\\nvielen Dank! Ihre Registrierungsnummer: ' + $json.body.registration_id + '\\nPersonen: ' + $json.body.guest_count + ($json.body.status === 'waitlisted' ? '\\n\\nSie stehen auf der Warteliste. Wir melden uns, sobald Plätze frei werden.' : '\\n\\nBitte zeigen Sie die Nummer am Eingang.') : 'Hello ' + $json.body.name + ',\\n\\nthank you! Your registration number: ' + $json.body.registration_id + '\\nPeople: ' + $json.body.guest_count + ($json.body.status === 'waitlisted' ? '\\n\\nYou are on the waiting list. We will contact you if places become free.' : '\\n\\nPlease show this number at the entrance.') }}",
        "options": {}
      },
      "id": "a1f0c2d4-0004-4c1e-9a10-000000000004",
      "name": "Send confirmation (Gmail)",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [540, 300],
      "credentials": {
        "gmailOAuth2": { "id": "REPLACE_ME", "name": "Gmail account" }
      }
    }
  ],
  "connections": {
    "New registration": {
      "main": [[
        { "node": "Notify organizers (Telegram)", "type": "main", "index": 0 },
        { "node": "Guest left an email?", "type": "main", "index": 0 }
      ]]
    },
    "Guest left an email?": {
      "main": [[{ "node": "Send confirmation (Gmail)", "type": "main", "index": 0 }], []]
    }
  },
  "settings": { "executionOrder": "v1" }
}
