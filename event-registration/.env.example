# ---------------------------------------------------------------------------
# Copy to .env (local) or set in your host's dashboard (Vercel → Settings → Environment Variables).
# Never commit real values.
# ---------------------------------------------------------------------------

# [REQUIRED] PostgreSQL connection string.
# Supabase: Project → Connect → "Transaction pooler" (port 6543) for Vercel/serverless.
DATABASE_URL=postgres://user:password@host:5432/dbname
# [OPTIONAL] Max connections per server instance (keep small on serverless).
DATABASE_POOL_MAX=5

# [REQUIRED] Random string, at least 32 characters. Signs admin sessions and form tokens.
#   generate: openssl rand -base64 48
SESSION_SECRET=

# [REQUIRED] Password for the organizer dashboard at /admin. Use a long passphrase.
ADMIN_PASSWORD=

# [OPTIONAL] Public URL of the site (no trailing slash). Optional on Vercel (its domain is detected); set it for your own domain.
PUBLIC_SITE_URL=https://your-event.example.com

# [FOR n8n] n8n webhook (Production URL of your Webhook node). Leave empty to disable.
N8N_WEBHOOK_URL=
# [REQUIRED WITH N8N_WEBHOOK_URL] Sent as header "X-Webhook-Secret" (+ HMAC signature in "X-Webhook-Signature"). openssl rand -hex 24
N8N_WEBHOOK_SECRET=

# [FOR ONLINE PAYMENT] Stripe secret key (Stripe → Developers → API keys). sk_test_… for testing, sk_live_… for real payments.
STRIPE_SECRET_KEY=
# [FOR ONLINE PAYMENT] Signing secret of the webhook endpoint https://your-domain/api/stripe/webhook (whsec_…).
STRIPE_WEBHOOK_SECRET=

# [REQUIRED IN PRODUCTION] Protects /api/cron (webhook retries + GDPR auto-deletion).
# Vercel Cron sends it automatically. Without it, personal data is NOT deleted automatically.
CRON_SECRET=

# [OPTIONAL] Country code assumed for local numbers like "0176 1234567" (49 = Germany).
DEFAULT_PHONE_COUNTRY_CODE=49
# [OPTIONAL] Time zone for dashboard dates and the calendar file.
EVENT_TIMEZONE=Europe/Berlin
