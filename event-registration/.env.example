# ---------------------------------------------------------------------------
# Copy to .env (local) or set in your host's dashboard (Vercel → Settings → Environment Variables).
# Never commit real values.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# Supabase: Project → Connect → "Transaction pooler" (port 6543) for Vercel/serverless.
DATABASE_URL=postgres://user:password@host:5432/dbname
# Max connections per server instance (keep small on serverless).
DATABASE_POOL_MAX=5

# Random string, at least 32 characters. Signs admin sessions and form tokens.
#   generate: openssl rand -base64 48
SESSION_SECRET=

# Password for the organizer dashboard at /admin. Use a long passphrase.
ADMIN_PASSWORD=

# Public URL of the site (no trailing slash). Optional on Vercel (its domain is detected); set it for your own domain.
PUBLIC_SITE_URL=https://your-event.example.com

# n8n webhook (Production URL of your Webhook node). Leave empty to disable.
N8N_WEBHOOK_URL=
# Sent as header "X-Webhook-Secret" (+ HMAC signature in "X-Webhook-Signature"). openssl rand -hex 24
N8N_WEBHOOK_SECRET=

# Protects /api/cron (webhook retries + GDPR auto-deletion). Vercel Cron sends it automatically.
CRON_SECRET=

# Country code assumed for local numbers like "0176 1234567" (49 = Germany).
DEFAULT_PHONE_COUNTRY_CODE=49
# Time zone for dashboard dates and the calendar file.
EVENT_TIMEZONE=Europe/Berlin
